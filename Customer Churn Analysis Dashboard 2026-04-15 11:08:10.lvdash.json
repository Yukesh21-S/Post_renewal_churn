{
  "datasets": [
    {
      "name": "dataset1",
      "displayName": "churn_dashboard",
      "queryLines": [
        "select * from post_renewal_churn.cleaned_dataset.churn_dashboard"
      ],
      "columns": [
        {
          "displayName": "Churn Status",
          "expression": "CASE WHEN `label` = 1 THEN 'Churned' ELSE 'Retained' END"
        },
        {
          "displayName": "Revenue Tier",
          "expression": "CASE WHEN `Total_Amount` < 500 THEN '1. < $500' WHEN `Total_Amount` < 1000 THEN '2. $500-$1K' WHEN `Total_Amount` < 2000 THEN '3. $1K-$2K' WHEN `Total_Amount` < 5000 THEN '4. $2K-$5K' ELSE '5. $5K+' END"
        },
        {
          "displayName": "Price Impact",
          "expression": "COALESCE(`Renewal_Impact_Due_to_Price_Increase`, 'Unknown')"
        },
        {
          "displayName": "Call Type",
          "expression": "COALESCE(`Call_Direction`, 'No Call')"
        },
        {
          "displayName": "Tenure Flag",
          "expression": "CASE WHEN `is_low_tenure` = 1 THEN 'Low Tenure' ELSE 'Normal Tenure' END"
        },
        {
          "displayName": "Prediction Category",
          "expression": "CASE WHEN `prediction` = 1 AND `label` = 1 THEN 'True Positive' WHEN `prediction` = 0 AND `label` = 0 THEN 'True Negative' WHEN `prediction` = 1 AND `label` = 0 THEN 'False Positive' WHEN `prediction` = 0 AND `label` = 1 THEN 'False Negative' END"
        },
        {
          "displayName": "Churn Risk Percent",
          "expression": "`churn_probability` * 100"
        }
      ]
    }
  ],
